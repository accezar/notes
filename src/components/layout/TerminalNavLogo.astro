---
import { sitePath } from '../../utils/site-path';
import { SITE_NOTES_NAME, TERMINAL_LOGO } from '../../data/variables';
---

<a
	href={sitePath('')}
	class="terminal-logo"
	aria-label={`Início — ${SITE_NOTES_NAME}`}
	data-terminal-logo-text={TERMINAL_LOGO.text}
	data-terminal-logo-cycle-ms={TERMINAL_LOGO.cycleMs}
	data-terminal-logo-type-ms={TERMINAL_LOGO.typeMs}
	data-terminal-logo-erase-ms={TERMINAL_LOGO.eraseMs}
>
	<svg
		class="terminal-logo__chevron"
		width="16"
		height="22"
		viewBox="0 0 16 22"
		fill="none"
		xmlns="http://www.w3.org/2000/svg"
		aria-hidden="true"
	>
		<path
			d="M4 5L12 11L4 17"
			stroke="currentColor"
			stroke-width="2.65"
			stroke-linecap="round"
			stroke-linejoin="round"
		/>
	</svg>
	<span class="terminal-logo__chars" aria-hidden="true"></span>
</a>

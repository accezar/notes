---
import BlogPostLayout from '../layouts/BlogPostLayout.astro';
import { getBlogStaticPaths, renderBlogPostBySlug } from '../utils/site';

export const getStaticPaths = getBlogStaticPaths;

const { post, Content, headings } = await renderBlogPostBySlug(Astro.params.slug);
---

<BlogPostLayout post={post} headings={headings}>
	<Content />
</BlogPostLayout>

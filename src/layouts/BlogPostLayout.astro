---
import BaseLayout from './BaseLayout.astro';
import PostHeroSection from '../components/post/PostHeroSection.astro';
import PostTableOfContents from '../components/post/PostTableOfContents.astro';
import PostWrittenBy from '../components/post/PostWrittenBy.astro';
import PostMermaid from '../components/react/PostMermaid';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { SITE_AUTHOR } from '../data/variables';
import { githubAvatarUrl, pageTitleWithBrand } from '../utils/site';

interface Props {
	post: CollectionEntry<'blog'>;
	headings: MarkdownHeading[];
}

const { post, headings } = Astro.props;
const { title, description, thumbnail } = post.data;
const pageTitle = pageTitleWithBrand(title);
const authorAvatarUrl = githubAvatarUrl(SITE_AUTHOR.githubUsername);
---

<BaseLayout
	title={pageTitle}
	description={description}
	image={thumbnail}
	type="article"
	bodyClass="page-body--clean"
>
	<PostHeroSection data={post.data} body={post.body} />
	<div class="shell--lecture post-page">
		<article class="post-article">
			<div class="post-article__main">
				{post.data.toc ? (
					<PostTableOfContents
						headings={headings}
						maxDepth={post.data.tocMaxDepth}
						minDepth={post.data.tocMinDepth}
					/>
				) : null}
				<slot />
				<PostMermaid client:load />
				<script src="../scripts/entries/code-blocks.ts"></script>
				<PostWrittenBy
					authorName={SITE_AUTHOR.name}
					authorBio={SITE_AUTHOR.bio}
					avatarUrl={authorAvatarUrl}
				/>
			</div>
		</article>
	</div>
	<dialog
		id="post-image-lightbox"
		class="post-image-lightbox"
		aria-label="Visualização ampliada da imagem"
		closedby="any"
	>
		<button
			type="button"
			class="post-image-lightbox__close"
			data-post-image-lightbox-close
			aria-label="Fechar visualização"
		>
			<span class="sr-only">Fechar</span>
			<svg
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				aria-hidden="true"
			>
				<path d="M18 6 6 18M6 6l12 12" />
			</svg>
		</button>
		<img class="post-image-lightbox__img" alt="" decoding="async" />
	</dialog>
	<dialog
		id="post-mermaid-lightbox"
		class="post-mermaid-lightbox"
		aria-label="Visualização ampliada do diagrama"
		closedby="any"
	>
		<div class="post-mermaid-lightbox__toolbar" aria-label="Controles do diagrama">
			<button type="button" data-mermaid-zoom-out aria-label="Diminuir zoom">−</button>
			<output data-mermaid-zoom aria-live="polite">100%</output>
			<button type="button" data-mermaid-zoom-in aria-label="Aumentar zoom">+</button>
			<button type="button" data-mermaid-zoom-reset>Redefinir</button>
			<button type="button" data-mermaid-close>Fechar</button>
		</div>
		<div class="post-mermaid-lightbox__viewport" data-mermaid-viewport tabindex="0">
			<div class="post-mermaid-lightbox__canvas" data-mermaid-canvas></div>
		</div>
	</dialog>
	<script src="../scripts/entries/post-image-lightbox.ts"></script>
</BaseLayout>

---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import GoogleAnalytics from '../components/layout/GoogleAnalytics.astro';
import ScrollToTop from '../components/layout/ScrollToTop.astro';
import { HEAD_THEME_INLINE } from '../scripts/theme-persistence';
import { canonicalUrl } from '../utils/site';
import { sitePath } from '../utils/site-path';

interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	bodyClass?: string;
}

const { title, description, image, type = 'website', bodyClass } = Astro.props;
const canonicalHref = canonicalUrl(Astro.site, Astro.url.pathname);
const imageHref = image
	? new URL(
			/^https?:\/\//i.test(image) ? image : sitePath(image),
			Astro.site ?? Astro.url.origin,
		).href
	: undefined;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline set:html={HEAD_THEME_INLINE}></script>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Inter+Tight:wght@500;600;700&display=swap"
			rel="stylesheet"
		/>
		<link rel="icon" type="image/svg+xml" href={sitePath('favicon.svg')} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{description ? <meta name="description" content={description} /> : null}
		{canonicalHref ? <link rel="canonical" href={canonicalHref} /> : null}
		<meta property="og:type" content={type} />
		<meta property="og:title" content={title} />
		{description ? <meta property="og:description" content={description} /> : null}
		{canonicalHref ? <meta property="og:url" content={canonicalHref} /> : null}
		{imageHref ? (
			<>
				<meta property="og:image" content={imageHref} />
				<meta property="og:image:alt" content={title} />
			</>
		) : null}
		<meta name="twitter:card" content={imageHref ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={title} />
		{description ? <meta name="twitter:description" content={description} /> : null}
		{imageHref ? (
			<>
				<meta name="twitter:image" content={imageHref} />
				<meta name="twitter:image:alt" content={title} />
			</>
		) : null}
		<GoogleAnalytics />
	</head>
	<body class:list={['site-body', bodyClass].filter(Boolean)}>
		<Header />
		<div class="site-main">
			<slot />
		</div>
		<Footer />
		<ScrollToTop />
		<script src="../scripts/entries/site-vanilla.ts"></script>
	</body>
</html>
